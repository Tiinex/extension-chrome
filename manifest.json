{
  "manifest_version": 3,
  "name": "Tiinex Operator Aid",
  "version": "0.1.0",
  "description": "Observable run timing and conservative Handoff download ergonomics.",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tiinex Operator Aid",
    "default_popup": "src/popup/popup.html"
  }
}
